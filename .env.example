# Copy to .env for local overrides. Never commit .env.
#
# Docker Compose reads .env automatically. Spring Boot does NOT:
# - Without the "local" profile, the backend requires these as real environment variables
#   and fails at startup if any are missing.
# - With the "local" profile, the backend falls back to the same development defaults
#   as docker-compose.yml. If you change a value here, export it for the backend as well.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=platform
DB_USERNAME=platform
DB_PASSWORD=change-me
